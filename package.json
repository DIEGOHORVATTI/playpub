{
  "name": "playpub",
  "version": "0.1.0",
  "description": "CLI para automatizar a publicação de apps Android na Google Play Console — do zero ao teste fechado. Monorepo-friendly (N apps por repo).",
  "type": "module",
  "bin": {
    "playpub": "dist/cli.js"
  },
  "files": [
    "dist",
    "playpub.config.example.json"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/mcp.ts --format esm --clean --target node18",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "google-play",
    "play-console",
    "android",
    "publish",
    "cli",
    "fastlane",
    "monorepo",
    "expo",
    "rpa"
  ],
  "author": "Diego Horvatti",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "googleapis": "^144.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
